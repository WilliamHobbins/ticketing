{
  "name": "ticketing-users-service",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio de usuarios para el proyecto Sistema de Tickets",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.1",
