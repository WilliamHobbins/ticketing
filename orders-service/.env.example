# Para correr orders-service fuera de Docker (npm run dev).
# Dentro de Docker estas variables las define el docker-compose.yml.
NODE_ENV=development
PORT=3004
DATABASE_URL=postgres://ticketing:change_this_postgres_password@localhost:5432/ticketing_orders
BROKER_URL=amqp://ticketing:change_this_rabbit_password@localhost:5672
INVENTORY_URL=http://localhost:8083
EVENTS_EXCHANGE=ticketing.events
LOG_LEVEL=info
