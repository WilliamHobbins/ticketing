          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latencia p95 - Inventory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"inventory-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pedidos y pagos - Orders",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(orders_created_total{job=\"orders-service\"}[1h])",
          "legendFormat": "Pedidos creados",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (increase(payments_total{job=\"orders-service\"}[1h]))",
          "legendFormat": "Pagos - {{result}}",
          "refId": "B"
        }
      ]
    },
    {
