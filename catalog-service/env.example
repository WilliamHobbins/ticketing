# Copiar a .env para correr catalog-service fuera de Docker (npm run dev).
# Con Docker Compose estas variables las define docker-compose.yml.
PORT=3002
NODE_ENV=development            # en producción: production (apaga GraphiQL e introspección)
DATABASE_URL=postgres://ticketing:change_this_postgres_password@localhost:5432/ticketing_catalog
REDIS_URL=redis://localhost:6379
CATALOG_CACHE_TTL=60            # segundos de caché para lecturas
CATALOG_SEED=true               # false = no cargar datos de ejemplo
LOG_LEVEL=info
