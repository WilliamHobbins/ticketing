# Para correr fuera de Docker (npm run dev). Con docker compose se inyectan desde el .env de la raíz.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://ticketing:change_this_postgres_password@localhost:5432/ticketing_users
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
LOG_LEVEL=debug
