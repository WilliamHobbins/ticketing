# Copiar a .env y cambiar los secretos antes de compartir el proyecto.
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_PORT=5432

REDIS_PORT=6379
RABBITMQ_USER=ticketing
RABBITMQ_PASSWORD=change_this_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

GATEWAY_PORT=8080

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_grafana_password

LOG_LEVEL=info
